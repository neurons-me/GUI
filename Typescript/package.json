{
  "name": "this.gui",
  "description": "Generative User Interface",
  "private": false,
  "version": "3.0.0",
  "type": "module",
  "main": "./dist/this.gui.cjs",
  "module": "./dist/this.gui.es.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "sui.Gn - neurons.me",
  "keywords": [
    "Generative",
    "UI",
    "declarative-ui",
    "json-ui"
  ],
  "sideEffects": [
    "**/*.css",
    "dist/legacy/**",
    "dist/src/legacy/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/this.gui.es.js",
      "require": "./dist/this.gui.cjs"
    },
    "./legacy": {
      "types": "./dist/src/legacy/index.d.ts",
      "import": "./dist/legacy/index.js",
      "require": "./dist/legacy/index.cjs"
    },
    "./runtime": {
      "types": "./dist/src/runtime-entry.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs"
    },
    "./react": {
      "types": "./dist/src/react-entry.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./devtools": {
      "types": "./dist/src/devtools-entry.d.ts",
      "import": "./dist/devtools/index.js",
      "require": "./dist/devtools/index.cjs"
    },
    "./cleaker": {
      "types": "./dist/src/cleaker-entry.d.ts",
      "import": "./dist/cleaker/index.js",
      "require": "./dist/cleaker/index.cjs"
    },
    "./style.css": "./dist/material-symbols.css",
    "./style": "./dist/material-symbols.css",
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js",
      "require": "./dist/atoms/index.cjs"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "import": "./dist/molecules/index.js",
      "require": "./dist/molecules/index.cjs"
    },
    "./compounds": {
      "types": "./dist/compounds/index.d.ts",
      "import": "./dist/compounds/index.js",
      "require": "./dist/compounds/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "gui": "./dist/bin/cli.js",
    "this.gui": "./dist/bin/cli.js"
  },
  "scripts": {
    "docs:api": "typedoc",
    "docs:api:watch": "typedoc --watch",
    "docs:dev": "vitepress dev typedocs",
    "docs:build": "vitepress build typedocs",
    "docs:preview": "vitepress preview typedocs",
    "docs:publish": "npm run docs:api && npm run docs:build",
    "prebuild": "npm run test:runtime",
    "build": "vite build && npm run build:types && npm run build:types:sync && npm run build:cli && npm run build:umd",
    "build:all": "npm run build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:types:sync": "node -e \"const fs=require('fs-extra'); const path=require('path'); const pick=(candidates)=>{ const found=candidates.find(fs.existsSync); if(!found) throw new Error('Missing type file. Tried: ' + candidates.join(', ')); return found; }; const copy=(from,to)=>{ fs.ensureDirSync(path.dirname(to)); fs.copyFileSync(from,to); }; copy(pick(['dist/src/gui/Atoms/atoms.d.ts']),'dist/atoms/index.d.ts'); copy(pick(['dist/src/gui/Molecules/molecules.d.ts','dist/src/gui/molecules/molecules.d.ts']),'dist/molecules/index.d.ts'); copy(pick(['dist/src/gui/Compounds/compounds.d.ts']),'dist/compounds/index.d.ts'); copy(pick(['dist/src/gui/Compounds/compounds.d.ts']),'dist/components/index.d.ts');\"",
    "build:cli": "tsc --project tsconfig.cli.json && node -e \"import('./vite.config.js').then(m => (m.buildFinished ? m.buildFinished() : Promise.reject(new Error('buildFinished() not exported from vite.config.js')))).catch(e => { console.error(e); process.exit(1); })\"",
    "build:copy-init": "node -e \"const fs=require('fs-extra'); if(!fs.existsSync('init')){throw new Error('init directory missing at project root');} fs.removeSync('dist/init'); fs.copySync('init','dist/init'); if(fs.existsSync('init-main-server-ui')){fs.removeSync('dist/init-main-server-ui'); fs.copySync('init-main-server-ui','dist/init-main-server-ui');} if(fs.existsSync('init-child')){fs.removeSync('dist/init-child'); fs.copySync('init-child','dist/init-child');}\"",
    "build:umd:core": "UMD=true UMD_TARGET=core vite build",
    "build:umd:bootstrap": "UMD=true UMD_TARGET=bootstrap vite build",
    "build:umd:searchbar": "UMD=true UMD_TARGET=searchbar vite build",
    "build:umd": "npm run build:umd:core && npm run build:umd:bootstrap && npm run build:umd:searchbar",
    "test:runtime": "tsx tests/markdown-document-core.test.ts && tsx tests/monad-discovery-core.test.ts && tsx tests/registryMetaCoverage.test.ts && tsx tests/sidebarComposition.test.ts && tsx tests/inspectorNav.test.ts && tsx tests/guiLocalKernel.test.ts && tsx tests/guiDocument.test.ts && tsx tests/leftBarIds.test.ts && tsx tests/netgetSetupClient.test.ts && tsx tests/namespaceNames.test.ts && tsx tests/rootTransport.test.ts",
    "pack:local": "npm run build && npm pack",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "dev:monad": "vite",
    "dev:demo": "DEMO=true vite",
    "dev:lib": "vite build --watch",
    "dev:root": "vite",
    "preview": "DEMO=true vite preview",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build -o ../storybook && node scripts/fix-storybook-static-base.mjs",
    "chromatic": "STORYBOOK=true chromatic"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@lexical/link": "^0.33.1",
    "@lexical/list": "^0.33.1",
    "@lexical/react": "^0.33.1",
    "@lexical/rich-text": "^0.33.1",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@mui/icons-material": "^6.5.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@scure/bip39": "^2.4.0",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@uiw/react-md-editor": "^4.0.11",
    "cleaker": "file:../../../modules/cleaker/Typescript",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "fs-extra": "^11.3.2",
    "js-cookie": "^3.0.5",
    "js-sha3": "^0.9.3",
    "kolorist": "^1.8.0",
    "lexical": "^0.33.1",
    "lucide-react": "^1.6.0",
    "material-symbols": "^0.35.2",
    "prompts": "^2.4.2",
    "qrcode-generator": "^2.0.4",
    "qrcode.react": "^4.2.0",
    "react-draggable": "^4.4.6",
    "react-feather": "^2.0.10",
    "react-syntax-highlighter": "^16.1.0",
    "react-webcam": "^7.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "this.me": "file:../../../me/Typescript",
    "three": "^0.169.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.21.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@mui/material": "^6.4.6",
    "@mui/system": "^6.5.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/supertest": "^7.2.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "chromatic": "^13.3.5",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^15.15.0",
    "playwright": "^1.55.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3",
    "storybook": "^10.4.6",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "@mui/material": "^6.0.0",
    "@mui/system": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
