{
  "GUI": {
    "note": "Generative User Interface: a static declaration the GUI can boot from; a connected .me resolves it.",
    "children": {
      "window": {
        "label": "Window",
        "note": "The surface this GUI is presented on.",
        "children": {
          "layout": {
            "label": "Layout",
            "note": "The window's structure: bars around the content. Each part's box and whether a bar is on live in `props`, so a host (this .GUI or cleaker.js) just loads the tree.",
            "children": {
              "bars": {
                "note": "The edge bars around the content. All five are declared. `props.on` is whether the namespace layout mounts the bar. cleaker.js uses `props.state` (open | icons | closed) and defaults to closed, so a foreign page stays unchanged until someone unfolds a bar.",
                "children": {
                  "top": {
                    "note": "Top bar.",
                    "label": "Top bar",
                    "props": {
                      "on": true
                    },
                    "children": {
                      "search": {
                        "label": "Search",
                        "component": "SearchField",
                        "note": "Directory search, fixed at the top-right of every route.",
                        "children": {
                          "toggle": {
                            "label": "Search button"
                          }
                        }
                      }
                    }
                  },
                  "sticky": {
                    "note": "Sticky options strip under the top bar.",
                    "label": "Sticky options",
                    "props": {
                      "on": false
                    }
                  },
                  "left": {
                    "note": "Left sidebar. Its elements are declared here; what the namespace adds is layered around them.",
                    "label": "Left bar",
                    "props": {
                      "on": true,
                      "view": "rail",
                      "railWidth": 72,
                      "expandedWidth": 220
                    },
                    "children": {
                      "home": {
                        "label": "Home",
                        "to": "/",
                        "icon": "home",
                        "placement": "start"
                      },
                      "users": {
                        "label": "Users",
                        "to": "/users",
                        "icon": "group"
                      },
                      "blockchain": {
                        "label": "Blockchain",
                        "to": "/blockchain",
                        "icon": "link"
                      },
                      "url": {
                        "label": "URL",
                        "to": "/url",
                        "icon": "language"
                      },
                      "keychain": {
                        "label": "Keychain",
                        "to": "/keychain",
                        "icon": "key",
                        "requires": "session",
                        "placement": "end"
                      },
                      "netget": {
                        "label": "Netget",
                        "to": "/netget",
                        "icon": "cable",
                        "placement": "end"
                      }
                    }
                  },
                  "right": {
                    "note": "Right sidebar.",
                    "label": "Right bar",
                    "props": {
                      "on": false
                    }
                  },
                  "bottom": {
                    "note": "Bottom bar (the Footer component).",
                    "label": "Bottom bar",
                    "props": {
                      "on": false
                    }
                  }
                },
                "label": "Bars"
              },
              "qr": {
                "label": "QR",
                "note": "The person's QR mark in this window.",
                "children": {
                  "position": {
                    "label": "QR.Position",
                    "note": "Which corner the QR occupies: top-left, top-right, bottom-left, or bottom-right.",
                    "props": {
                      "value": "top-left"
                    }
                  }
                }
              },
              "content": {
                "note": "Where the current page renders. Each child is a page: `component` implements it, `route` serves it. The shared column (maxWidth, minWidth, height, gutter) is declared here; pages inherit it.",
                "label": "Content",
                "props": {
                  "maxWidth": 1120,
                  "minWidth": 0,
                  "height": "100%",
                  "gutter": 1.618
                },
                "children": {
                  "landing": {
                    "component": "Landing",
                    "route": "/.me",
                    "note": "The .me QR and sign-in / register / recover. Behavior stays in the component.",
                    "label": "Landing",
                    "children": {
                      "qr": {
                        "label": "QR",
                        "note": "The .me QR with its namespace and status.",
                        "children": {
                          "status": {
                            "label": "Status"
                          },
                          "namespace": {
                            "label": "Namespace",
                            "children": {
                              "edit": {
                                "label": "Edit namespace"
                              }
                            }
                          },
                          "code": {
                            "label": "QR code",
                            "children": {
                              "wordmark": {
                                "label": ".me mark"
                              }
                            }
                          }
                        }
                      },
                      "heading": {
                        "label": "Heading"
                      },
                      "username": {
                        "label": "Username"
                      },
                      "secret": {
                        "label": "Secret"
                      },
                      "submit": {
                        "label": "Submit"
                      },
                      "register": {
                        "label": "Register"
                      },
                      "recover": {
                        "label": "Recover"
                      }
                    }
                  },
                  "home": {
                    "label": "Home",
                    "component": "Landing",
                    "route": "/",
                    "note": "The namespace's own page: its QR in the center, ready to connect (rule 1 of 'What you see in each'). /.me is the same identity page by its own address."
                  },
                  "users": {
                    "component": "Users",
                    "route": "/users",
                    "needs": "monad",
                    "note": "Public claims directory: who has claimed this namespace.",
                    "label": "Users",
                    "children": {
                      "table": {
                        "label": "Users table",
                        "note": "One row per claimed user; the rows are data and appear under shell.rows when loaded.",
                        "children": {
                          "header": {
                            "label": "Header",
                            "children": {
                              "title": {
                                "label": "Title"
                              },
                              "namespace": {
                                "label": "Namespace"
                              },
                              "advanced": {
                                "label": "Advanced toggle"
                              }
                            }
                          },
                          "loading": {
                            "label": "Loading"
                          },
                          "error": {
                            "label": "Error"
                          },
                          "empty": {
                            "label": "Empty"
                          },
                          "shell": {
                            "label": "Table shell",
                            "children": {
                              "rows": {
                                "label": "Rows"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "blockchain": {
                    "component": "Blockchain",
                    "route": "/blockchain",
                    "needs": "monad",
                    "note": "Everything written to this namespace, as one stream.",
                    "label": "Blockchain",
                    "children": {
                      "table": {
                        "label": "Blocks table",
                        "note": "One row per block; the rows are data and appear under rows, by block number, when loaded.",
                        "children": {
                          "summary": {
                            "label": "Summary"
                          },
                          "rows": {
                            "label": "Rows",
                            "children": {
                              "head": {
                                "label": "Head"
                              },
                              "empty": {
                                "label": "Empty"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "url": {
                    "label": "URL",
                    "component": "Url",
                    "route": "/url",
                    "needs": "monad",
                    "note": "Opens a real NRP channel to a URL under this namespace root.",
                    "children": {
                      "heading": {
                        "label": "Heading"
                      },
                      "input": {
                        "label": "URL"
                      },
                      "submit": {
                        "label": "Open"
                      }
                    }
                  },
                  "keychain": {
                    "label": "Keychain",
                    "component": "Keychain",
                    "route": "/keychain",
                    "needs": "monad",
                    "note": "The signing keys of the signed-in identity."
                  },
                  "netget": {
                    "label": "Netget",
                    "component": "Netget",
                    "route": "/netget",
                    "needs": "backend",
                    "note": "The gateway that serves this namespace: its status, and setting it up.",
                    "children": {
                      "heading": {
                        "label": "Heading",
                        "note": "Shown when no gateway is reachable here."
                      },
                      "status": {
                        "label": "Main server",
                        "note": "Public identity and status of the gateway.",
                        "children": {
                          "host": {
                            "label": "Host"
                          },
                          "namespace": {
                            "label": "Namespace"
                          },
                          "owner": {
                            "label": "Owner"
                          },
                          "hash": {
                            "label": "Owner hash"
                          },
                          "openresty": {
                            "label": "OpenResty",
                            "children": {
                              "title": {
                                "label": "Title"
                              }
                            }
                          },
                          "entrypoints": {
                            "label": "Entrypoints",
                            "children": {
                              "title": {
                                "label": "Title"
                              }
                            }
                          }
                        }
                      },
                      "setup": {
                        "label": "Gateway setup",
                        "note": "Install and claim the gateway.",
                        "children": {
                          "code": {
                            "label": "Setup code"
                          },
                          "unlock": {
                            "label": "Unlock install"
                          },
                          "install": {
                            "label": "Install OpenResty"
                          },
                          "retry": {
                            "label": "Retry install"
                          },
                          "submit": {
                            "label": "Claim"
                          },
                          "review": {
                            "label": "Review"
                          },
                          "mark": {
                            "label": "NetGet mark"
                          }
                        }
                      },
                      "claim": {
                        "label": "Claim",
                        "component": "Claim",
                        "route": "/keychain/claim",
                        "note": "Signs the claim of this gateway with the identity's key.",
                        "children": {
                          "heading": {
                            "label": "Heading"
                          },
                          "signin": {
                            "label": "Sign in"
                          },
                          "passphrase": {
                            "label": "Passphrase"
                          },
                          "confirm": {
                            "label": "Confirm"
                          }
                        }
                      },
                      "sign": {
                        "label": "Sign",
                        "component": "Sign",
                        "route": "/keychain/admin-sign",
                        "note": "Signs an admin action for the gateway with the identity's key.",
                        "children": {
                          "heading": {
                            "label": "Heading"
                          },
                          "signin": {
                            "label": "Sign in"
                          },
                          "passphrase": {
                            "label": "Passphrase"
                          },
                          "confirm": {
                            "label": "Confirm"
                          }
                        }
                      }
                    }
                  },
                  "gui": {
                    "label": "GUI",
                    "component": "GuiPage",
                    "route": "/GUI",
                    "note": "What is drawing this page: this.gui, the active theme, the layout. Its content is the parts below, drawn in this order.",
                    "children": {
                      "heading": {
                        "label": "Heading",
                        "component": "GuiHeading",
                        "props": {
                          "title": ".GUI",
                          "titleStyle": "brand",
                          "version": true
                        },
                        "children": {
                          "title": {
                            "label": "Title"
                          },
                          "version": {
                            "label": "Version",
                            "note": "this.gui's version, beside the name."
                          }
                        }
                      },
                      "theme": {
                        "label": "Theme",
                        "component": "GuiRow",
                        "props": {
                          "label": "Theme"
                        },
                        "children": {
                          "active": {
                            "label": "Active theme",
                            "component": "ActiveTheme",
                            "props": {
                              "to": "/GUI/themes"
                            },
                            "note": "The active theme's avatar and name: the way to its page."
                          },
                          "mode": {
                            "label": "Mode",
                            "component": "ThemeMode",
                            "note": "Light or dark, as the theme's own control."
                          }
                        }
                      },
                      "tree": {
                        "label": "Layout",
                        "component": "GuiRow",
                        "props": {
                          "label": "Layout"
                        },
                        "children": {
                          "link": {
                            "label": "Link",
                            "component": "RouteLink",
                            "props": {
                              "to": "/GUI/layout",
                              "text": "the tree this page declares"
                            }
                          }
                        }
                      },
                      "themes": {
                        "label": "Themes",
                        "component": "GuiPage",
                        "route": "/GUI/themes",
                        "note": "The active theme: the theme strip, its palette and its typography. Used to be a dialog opened from the theme launcher's gear.",
                        "children": {
                          "heading": {
                            "label": "Heading",
                            "component": "GuiHeading",
                            "props": {
                              "title": "Themes",
                              "parents": [
                                {
                                  "label": "GUI",
                                  "to": "/GUI"
                                }
                              ],
                              "spacing": 2
                            },
                            "children": {
                              "trail": {
                                "label": "Trail",
                                "note": "Where the page sits under /GUI, each step a link."
                              },
                              "title": {
                                "label": "Title"
                              },
                              "mode": {
                                "label": "Mode",
                                "component": "ThemeMode"
                              }
                            }
                          },
                          "inspector": {
                            "label": "Theme",
                            "component": "ThemeInspectorPanel",
                            "props": {
                              "routes": {
                                "palette": "/GUI/themes",
                                "typography": "/GUI/themes/typography"
                              }
                            },
                            "children": {
                              "strip": {
                                "label": "Theme strip",
                                "note": "Every theme; click one to switch."
                              },
                              "tabs": {
                                "label": "Tabs",
                                "children": {
                                  "palette": {
                                    "label": "Palette"
                                  },
                                  "typography": {
                                    "label": "Typography"
                                  }
                                }
                              },
                              "palette": {
                                "label": "Palette",
                                "note": "Each color of the theme with its shades and value."
                              },
                              "typography": {
                                "label": "Typography",
                                "note": "The active theme's type scale."
                              }
                            }
                          },
                          "typography": {
                            "label": "Typography",
                            "component": "GuiPage",
                            "route": "/GUI/themes/typography",
                            "props": {
                              "partsOf": "GUI.window.layout.content.gui.themes"
                            },
                            "note": "The same page with the Typography tab open."
                          }
                        }
                      },
                      "layout": {
                        "label": "Layout",
                        "component": "GuiPage",
                        "route": "/GUI/layout",
                        "note": "The tree this page declares (this document plus what the app adds).",
                        "children": {
                          "heading": {
                            "label": "Heading",
                            "component": "GuiHeading",
                            "props": {
                              "title": "Layout",
                              "parents": [
                                {
                                  "label": "GUI",
                                  "to": "/GUI"
                                }
                              ],
                              "subtitle": "{parts} parts declared. Bold: a part with its own component."
                            },
                            "children": {
                              "trail": {
                                "label": "Trail",
                                "note": "Where the page sits under /GUI, each step a link."
                              },
                              "title": {
                                "label": "Title"
                              },
                              "subtitle": {
                                "label": "Subtitle"
                              }
                            }
                          },
                          "tree": {
                            "label": "Tree",
                            "component": "DocumentTree"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
