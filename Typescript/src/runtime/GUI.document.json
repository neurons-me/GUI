{
  "GUI": {
    "note": "Generative User Interface: a static declaration the GUI can boot from; a connected .me resolves it.",
    "children": {
      "bars": {
        "note": "The edge bars around the content. All five are declared; which are on is resolved at runtime.",
        "children": {
          "top": {
            "note": "Top bar.",
            "label": "Top bar",
            "children": {
              "search": {
                "label": "Search",
                "component": "SearchField",
                "note": "Directory search, fixed at the top-right of every route.",
                "children": {
                  "toggle": {
                    "label": "Search button"
                  }
                }
              }
            }
          },
          "sticky": {
            "note": "Sticky options strip under the top bar.",
            "label": "Sticky options"
          },
          "left": {
            "note": "Left sidebar.",
            "label": "Left bar"
          },
          "right": {
            "note": "Right sidebar.",
            "label": "Right bar"
          },
          "footer": {
            "note": "Footer bar.",
            "label": "Footer"
          }
        },
        "label": "Bars"
      },
      "content": {
        "note": "Where the current page renders. Each child is a page: `component` implements it, `route` serves it.",
        "children": {
          "landing": {
            "component": "CleakerLanding",
            "route": "/",
            "note": "The .me QR and sign-in / register / recover. Behavior stays in the component.",
            "label": "Landing",
            "children": {
              "qr": {
                "label": "QR",
                "note": "The .me QR with its namespace and status.",
                "children": {
                  "status": {
                    "label": "Status"
                  },
                  "namespace": {
                    "label": "Namespace",
                    "children": {
                      "edit": {
                        "label": "Edit namespace"
                      }
                    }
                  },
                  "code": {
                    "label": "QR code",
                    "children": {
                      "wordmark": {
                        "label": ".me mark"
                      }
                    }
                  }
                }
              },
              "heading": {
                "label": "Heading"
              },
              "username": {
                "label": "Username"
              },
              "secret": {
                "label": "Secret"
              },
              "submit": {
                "label": "Submit"
              },
              "register": {
                "label": "Register"
              },
              "recover": {
                "label": "Recover"
              }
            }
          },
          "users": {
            "component": "CleakerUsersView",
            "route": "/users",
            "note": "Public claims directory: who has claimed this namespace.",
            "label": "Users"
          },
          "blockchain": {
            "component": "CleakerBlockchainView",
            "route": "/blockchain",
            "note": "Everything written to this namespace, as one stream.",
            "label": "Blockchain"
          }
        },
        "label": "Content"
      }
    }
  }
}
